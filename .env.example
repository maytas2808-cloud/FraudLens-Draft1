# Gmail integration. Copy to .env and fill in. Never commit .env.

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the authorised redirect URI in Google Cloud: <BASE_URL>/auth/callback
BASE_URL=http://localhost:8000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# How often to check inboxes for new mail (seconds, minimum 30)
POLL_SECONDS=90
# How many recent inbox emails to check right after someone signs in
INITIAL_SCAN=20
